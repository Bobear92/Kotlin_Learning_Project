    "name": "Nuuly Inventory API",
    "description": "Happy and unhappy calls for all four endpoints in src/main/resources/openapi/inventory.yaml. Run the whole collection in order (Postman's Collection Runner, or `npx newman run`): later requests use stock that earlier ones created. Each run uses fresh SKU ids, so you can repeat it without restarting the app.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "sku",
      "value": ""
    },
    {
      "key": "bigSku",
      "value": ""
    },
    {
      "key": "missingSku",
      "value": ""
    },
    {
      "key": "upperSku",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. POST /inventory/{skuId} (add stock)",
      "item": [
        {
          "name": "Happy",
          "item": [
            {
              "name": "New SKU is created -> 200",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Fresh SKUs on every run, so the collection can be re-run without restarting the app.",
                      "// e.g. postman-20261001-131502 (local date and time of the run)",
                      "const d = new Date();",
                      "const pad = n => String(n).padStart(2, '0');",
                      "const stamp = `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}-${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`;",
                      "const sku = 'postman-' + stamp;",
                      "pm.collectionVariables.set('sku', sku);",
                      "pm.collectionVariables.set('bigSku', sku + '-big');",
                      "pm.collectionVariables.set('missingSku', sku + '-missing');",
                      "pm.collectionVariables.set('upperSku', sku.toUpperCase());"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('200 OK', () => pm.response.to.have.status(200));",
                      "pm.test('application/json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                      "pm.test('body is the item', () => pm.expect(pm.response.json()).to.eql({ skuId: pm.collectionVariables.get('sku'), quantity: 10 }));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/inventory/{{sku}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "inventory",
                    "{{sku}}"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\"quantity\": 10}"
                }
              }
            },
            {
              "name": "Existing SKU adds to stock -> 200",
              "event": [
